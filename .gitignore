# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
pexels-videos.json

# uploads disque local (stockage de fallback quand R2 n'est pas configuré)
/public/uploads/

# Playwright (artefacts d'exécution : traces, screenshots, vidéos d'erreur)
test-results/
playwright-report/

# Valeurs publiques du build de production (non versionnées)
.env.deploy
