# =============================================================================
# E-FormationGN — Variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs au fur et à mesure.
# Ne jamais committer le .env (déjà dans .gitignore).
# =============================================================================

# --- Application ---------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="E-FormationGN"

# --- Base de données (Supabase / Postgres) -------------------------------------
# Format Supabase pooler (port 6543) recommandé pour Next.js / serverless.
# DIRECT_URL = connexion directe (port 5432) utilisée par Prisma Migrate.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Read replica (optionnel) : pooler de la replica Supabase. Si vide → toutes
# les lectures passent par le primary (acceptable jusqu'à ~10k req/min). Au-delà,
# poser cette URL décharge le primary pour le catalogue public (/cours, /cours/[slug],
# /formateurs/[code]). Le checkout et le dashboard continuent d'utiliser DATABASE_URL
# pour éviter le read-after-write lag.
DATABASE_READ_URL=""

# --- NextAuth (Auth.js v5) -----------------------------------------------------
# NEXTAUTH_SECRET : générer via `npx auth secret` ou `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_32_CHAR_SECRET"

# --- OAuth Google (Google Cloud Console) ---------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (Paiements + Connect pour les formateurs) --------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Mux (Hébergement & streaming vidéo) ---------------------------------------
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# --- Classes virtuelles LiveKit Cloud -----------------------------------------
# L'URL est de forme wss://projet.livekit.cloud. Toutes les clés restent côté
# serveur ; aucune variable LiveKit ne doit être préfixée NEXT_PUBLIC_.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_WEBHOOK_SECRET=""

# --- Resend (Emails transactionnels) -------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contact@e-formationgn.com"

# --- Stockage fichiers (Cloudflare R2 ou Supabase Storage) ---------------------
# Si vous utilisez Supabase Storage : laisser vide et utiliser le client Supabase.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="e-formationgn"
R2_PUBLIC_URL=""

# --- Recherche (optionnel — Algolia) -------------------------------------------
# Laisser vide pour utiliser la recherche full-text Postgres par défaut.
ALGOLIA_APP_ID=""
ALGOLIA_ADMIN_KEY=""
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=""

# --- Plateforme / Commissions --------------------------------------------------
# Taux de commission en points de base : 1500 = 15%, 3000 = 30%
PLATFORM_DEFAULT_CURRENCY="EUR"
PLATFORM_COMMISSION_INSTRUCTOR_BPS="1500"
PLATFORM_COMMISSION_PLATFORM_BPS="3000"

# --- Rate limit distribué (Upstash Redis) --------------------------------------
# Si vide → fallback en mémoire (OK en dev / single-instance). REQUIS en prod
# multi-instance (Vercel, Fly, Docker scale) : sans ça, chaque pod a son propre
# compteur et la limite est multipliée par le nombre d'instances.
# Créer une DB gratuite : https://console.upstash.com/redis (free tier 10k cmd/jour).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron / Webhooks asynchrones -----------------------------------------------
# Bearer token utilisé par Vercel Cron pour appeler les routes /api/cron/*.
# OBLIGATOIRE en prod (sinon les crons retournent 401 et les Orders PENDING
# orphelins ne sont jamais réconciliés).
CRON_SECRET=""

# --- Sécurité headers ----------------------------------------------------------
# Politique CSP : "report-only" (défaut, signale sans bloquer) ou "enforce"
# (bloque les violations). Passer en enforce après 7 jours sans violation
# remontée par les rapports.
CSP_MODE="report-only"

# --- Captcha Cloudflare Turnstile (gratuit, privacy-first) ---------------------
# Si vide → captcha désactivé (dev, single user). En prod, créer un site key
# gratuit : https://dash.cloudflare.com/?to=/:account/turnstile (10M req/mois).
# Le widget s'auto-affiche sur /connexion et /inscription dès que les 2 sont set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Supervision Sentry (obligatoire en production) ---------------------------
# Le DSN n'est pas un secret, mais ne doit pas contenir de données utilisateur.
# Les deux valeurs sont requises par le préflight strict (serveur + navigateur).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Vidéo Mux : signed playback URLs (anti-leech) -----------------------------
# Si MUX_SIGNED_PLAYBACK=1 ET les 2 clés signées sont posées, les NOUVEAUX
# uploads utilisent une playback_policy "signed" → le playbackId seul ne suffit
# plus, il faut aussi un JWT signé serveur (expiration 1h par défaut).
# Les uploads existants en policy "public" restent accessibles tels quels.
# Créer les clés : https://dashboard.mux.com/settings/signing-keys
#   - MUX_SIGNING_KEY_ID : id (ex: "xxxxx")
#   - MUX_SIGNING_KEY_PRIVATE : la clé privée RS256 en BASE64 (PKCS#8)
MUX_SIGNED_PLAYBACK="0"
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_PRIVATE=""

# Active directement les comptes à l'inscription quand l'envoi d'emails
# (Resend) n'est pas encore configuré. Mettre "false" une fois Resend prêt.
AUTH_AUTO_VERIFY_EMAIL="false"

# --- Mode de fonctionnement de la plateforme -----------------------------------
# "marketplace" (défaut) : catalogue payant, panier, tunnel Stripe/CinetPay.
# "centre_formation"     : le centre crée les comptes (élèves ET formateurs) et
#                          attribue les formations. Inscription publique fermée,
#                          ni prix ni panier ni achat affichés. Le code de
#                          paiement reste en place mais dormant.
PLATFORM_MODE=marketplace
