# =============================================================================
# E-FormationGN — Variables d'environnement PRODUCTION (VPS Hostinger / Docker)
# =============================================================================
# 1. Copier en `.env` à la racine du projet sur le VPS
#    cp .env.production.example .env
# 2. Remplir TOUTES les valeurs marquées REPLACE_*
# 3. Lancer : docker compose up -d --build
# =============================================================================

# --- Domaine + HTTPS (Caddy) ---------------------------------------------------
# Domaine pointant déjà vers l'IP du VPS (record A).
DOMAIN=e-formation.example.com
# Email pour Let's Encrypt (renouvellement, expiration warnings).
ACME_EMAIL=admin@example.com

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=E-FormationGN
# URL publique de l'app (liens d'affiliation, emails, OG, sitemap…).
NEXT_PUBLIC_APP_URL=https://e-formation.example.com

# --- Base de données (Postgres dans le compose) -------------------------------
POSTGRES_USER=eformationgn
POSTGRES_DB=eformationgn
# ⚠️ Mot de passe en HEX UNIQUEMENT : openssl rand -hex 24
# (un mot de passe base64 contient +//= qui cassent le parseur de connexion
#  @prisma/adapter-pg au runtime → erreur 28P01. NE PAS utiliser base64.)
POSTGRES_PASSWORD=REPLACE_HEX_DB_PASSWORD

# URL de connexion Prisma — DOIT reprendre exactement les POSTGRES_* ci-dessus.
# Hôte = service "db" du compose. Requis par l'entrypoint (boot KO si absent).
DATABASE_URL=postgresql://eformationgn:REPLACE_HEX_DB_PASSWORD@db:5432/eformationgn?schema=public
# Connexion directe utilisée par `prisma migrate deploy` (identique ici en
# single-instance ; en multi-instance pointer DATABASE_URL sur le pooler 6543).
DIRECT_URL=postgresql://eformationgn:REPLACE_HEX_DB_PASSWORD@db:5432/eformationgn?schema=public

# --- NextAuth -----------------------------------------------------------------
# Générer : openssl rand -base64 32 (32 caractères minimum)
NEXTAUTH_SECRET=REPLACE_32_CHAR_RANDOM_SECRET_HERE_BASE64_OK_AS_LONG_AS_32_PLUS
# DOIT correspondre au domaine public (sinon login/redirections cassés).
NEXTAUTH_URL=https://e-formation.example.com

# --- Cron (sécurise /api/cron/cleanup) ----------------------------------------
# Générer : openssl rand -hex 32
CRON_SECRET=REPLACE_RANDOM_CRON_SECRET

# =============================================================================
# Intégrations — laisser vide si pas encore configuré (l'app dégrade proprement)
# =============================================================================

# --- OAuth Google (optionnel : activer le login Google) -----------------------
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID
# Origines autorisées : https://${DOMAIN}
# URI de redirection : https://${DOMAIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe + Stripe Connect (cartes internationales) -------------------------
# Cible : diaspora et clients EUR/USD. Pas de Mobile Money (utiliser CinetPay).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook : https://dashboard.stripe.com/webhooks → URL https://${DOMAIN}/api/webhooks/stripe
# Events : checkout.session.completed, payment_intent.payment_failed,
#          payment_intent.canceled, charge.refunded, charge.dispute.*,
#          account.updated, payout.paid, payout.failed
STRIPE_WEBHOOK_SECRET=
# https://dashboard.stripe.com/settings/connect → Client ID Express
STRIPE_CONNECT_CLIENT_ID=

# --- CinetPay (Mobile Money + cartes locales — Guinée + zone CFA) -------------
# Cible : élèves locaux. Supporte GNF (Orange Money / MTN MoMo Guinée), XOF
# (Sénégal/Côte d'Ivoire/Mali), USD, EUR.
# 1. Créer un compte sur https://www.cinetpay.com
# 2. Récupérer API Key, Site ID et Secret Key dans Paramètres → Intégration
# 3. Ajouter l'URL IPN : https://${DOMAIN}/api/webhooks/cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Mux (vidéo) --------------------------------------------------------------
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook : https://dashboard.mux.com/settings/webhooks → URL https://${DOMAIN}/api/webhooks/mux
MUX_WEBHOOK_SECRET=

# --- Resend (emails) ----------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Domaine vérifié dans Resend (DNS validé).
RESEND_FROM_EMAIL=E-FormationGN <noreply@example.com>

# --- Cloudflare R2 (stockage thumbnails / fichiers) ---------------------------
# https://dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=e-formationgn
# Custom domain R2 ou URL publique du bucket.
R2_PUBLIC_URL=

# --- Sentry (monitoring) ------------------------------------------------------
# https://sentry.io → Project settings → Client Keys (DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Anthropic (Tuteur IA — optionnel) ----------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Plateforme (commissions) -------------------------------------------------
PLATFORM_DEFAULT_CURRENCY=EUR
# 1500 = 15% commission instructeur (modèle où l'instructeur fixe le prix)
PLATFORM_COMMISSION_INSTRUCTOR_BPS=1500
# 3000 = 30% commission plateforme (modèle où la plateforme fixe le prix)
PLATFORM_COMMISSION_PLATFORM_BPS=3000
