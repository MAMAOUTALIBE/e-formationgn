// --- Webhook event log (idempotency + audit + retry) ------------------------
// Persiste chaque événement webhook reçu (Stripe, CinetPay, Mux). Sert à :
//   1. Dédupliquer les replays (Stripe rejoue après ACK manqué).
//   2. Auditer ce qui est entré (debug, compliance, investigation).
//   3. Permettre au cron `/api/cron/process-webhooks` de re-tenter les
//      handlers qui ont échoué (panne DB, timeout transitoire).
//
// La clé primaire `eventId` est l'ID fourni par le PSP (evt_xxx pour Stripe).
// Si on reçoit deux fois le même eventId, le 2e INSERT lève une violation
// de contrainte unique → on retourne 200 sans rejouer le handler.

enum WebhookSource {
  STRIPE
  CINETPAY
  MUX
}

enum WebhookStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model WebhookEvent {
  id          String        @id // eventId du PSP (evt_xxx, cpm_trans_id, …)
  source      WebhookSource
  type        String        // event type (checkout.session.completed, …)
  payload     Json          // payload brut pour audit + retry
  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?       @db.Text
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([source, type])
}

/// Couleurs de la coquille du CRM admin (barre latérale, header, footer),
/// réglables depuis /admin/parametres/branding.
///
/// Table à ligne unique : l'id est forcé à "singleton" côté applicatif, ce qui
/// rend l'upsert trivial et interdit structurellement plusieurs thèmes
/// concurrents. Les champs nuls signifient « garder la couleur par défaut de
/// la charte » — on ne stocke donc que ce que l'admin a explicitement choisi.
///
/// Seule la couleur de FOND est stockée : la couleur de texte est déduite de
/// la luminance à l'affichage, sinon un fond sombre choisi par l'admin
/// rendrait le menu illisible.
model AdminUiTheme {
  id        String   @id @default("singleton")
  sidebarBg String? // hex #RRGGBB
  headerBg  String? // hex #RRGGBB
  footerBg  String? // hex #RRGGBB
  textScale String? // compact | normal | confortable | grand — null = normal
  updatedAt DateTime @updatedAt
  updatedBy String? // User.id de l'admin ayant modifié (pas de FK : purement informatif)
}

// ---------------------------------------------------------------------------
// Gestion des sociétés clientes (mode centre de formation)
// ---------------------------------------------------------------------------

/// Société cliente à laquelle des élèves sont rattachés.
///
/// Première brique de l'enchaînement Société → Élèves → Inscriptions →
/// Sessions → Formations → Cours → Accès. Une société DOIT exister avant
/// qu'un élève puisse lui être rattaché : c'est pour ça que `User.companyId`
/// pointe ici et jamais l'inverse, et que l'interface impose un choix dans une
/// liste plutôt qu'une saisie libre — deux orthographes du même client
/// rendraient tout regroupement (facturation, dossier OPCO, statistiques)
/// faux.
model Company {
  id         String        @id @default(cuid())
  name       String
  /// Identifiant légal français. Unique quand il est renseigné : deux fiches
  /// portant le même SIRET sont forcément un doublon. Nullable car un client
  /// étranger ou une administration peut ne pas en avoir.
  siret      String?       @unique
  siren      String?
  vatNumber  String?

  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  country      String  @default("France")

  /// Interlocuteur : la personne qu'on appelle, pas nécessairement un compte
  /// de la plateforme — d'où des champs libres et non une relation vers User.
  contactName  String?
  contactEmail String?
  contactPhone String?

  /// Opérateur de compétences finançant les formations. Champ libre pour
  /// l'instant : la liste des OPCO est courte mais évolue par arrêté, et la
  /// figer dans un enum imposerait une migration à chaque changement.
  opco          String?
  /// Numéro d'adhérent / de dossier auprès de l'OPCO.
  opcoReference String?

  notes    String?       @db.Text
  status   CompanyStatus @default(ACTIVE)

  students User[]        @relation("CompanyStudents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([name])
}

/// Cycle de vie d'une société cliente.
///
/// Pas de suppression physique : une société archivée garde ses élèves, leurs
/// inscriptions et leur historique — supprimer la ligne effacerait la
/// traçabilité exigée d'un organisme de formation.
enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Formations (programmes) et sessions
// ---------------------------------------------------------------------------

/// Formation : un programme pédagogique regroupant plusieurs cours.
///
/// Distincte de `Course`, qui reste l'unité de contenu (sections, leçons,
/// progression, certificat). Une formation assemble ces briques en un parcours
/// vendable et finançable — « Titre pro Développeur web » peut réunir six
/// cours. C'est le niveau auquel un OPCO raisonne, pas le cours isolé.
model Program {
  id          String        @id @default(cuid())
  /// Référence interne du catalogue (ex. « TP-DEV-2026 »). Unique quand elle
  /// est renseignée : c'est elle qui figure sur les conventions et les
  /// dossiers de financement.
  code        String?       @unique
  title       String
  description String?       @db.Text
  /// Durée officielle en heures — donnée réglementaire d'une convention de
  /// formation, indépendante de la durée des vidéos.
  durationHours Int?
  status      ProgramStatus @default(DRAFT)

  courses  ProgramCourse[]
  sessions TrainingSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([title])
}

/// Composition d'une formation : quels cours, dans quel ordre.
///
/// Table de liaison explicite plutôt qu'une relation implicite : elle porte
/// `position`, l'ordre pédagogique du parcours, qu'une relation many-to-many
/// Prisma ne saurait pas stocker.
model ProgramCourse {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  position  Int     @default(0)

  createdAt DateTime @default(now())

  /// Un même cours ne peut figurer qu'une fois dans une formation.
  @@unique([programId, courseId])
  @@index([programId])
  @@index([courseId])
}

/// Session : instance datée d'une formation, à laquelle on inscrit des élèves.
///
/// Les dates ne sont pas décoratives : une convention de formation, une
/// demande de prise en charge OPCO et une feuille d'émargement exigent toutes
/// une période. C'est pourquoi l'inscription passe obligatoirement par une
/// session et jamais directement par une formation.
model TrainingSession {
  id        String        @id @default(cuid())
  programId String
  program   Program       @relation(fields: [programId], references: [id], onDelete: Restrict)
  /// Référence de session (ex. « 2026-S1-LYON »), reprise sur les documents.
  reference String?
  startDate DateTime
  endDate   DateTime
  /// Lieu ou modalité (« Distanciel », « Lyon — salle B »).
  location  String?
  /// Places disponibles. Null = pas de limite.
  capacity  Int?
  status    SessionStatus @default(PLANNED)
  notes     String?       @db.Text

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([status])
  @@index([startDate])
}

/// Cycle de vie d'une formation au catalogue.
enum ProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Cycle de vie d'une session.
///
/// `CANCELLED` est distinct de la suppression : une session annulée a pu
/// porter des inscriptions et des engagements de financement, son historique
/// doit rester consultable.
enum SessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Inscription : rattachement d'un élève à une session de formation.
///
/// Pivot de l'enchaînement. C'est elle qui porte les statuts métier et qui
/// COMMANDE les accès : passer une inscription à `ACTIVE` crée les
/// `Enrollment` de tous les cours du programme, la suspendre les retire.
///
/// Pourquoi dériver plutôt que remplacer `Enrollment` : les six points de
/// contrôle d'accès de l'application interrogent déjà `Enrollment`. En faisant
/// de l'inscription un pilote et non un substitut, aucun de ces contrôles n'a
/// besoin d'être modifié — donc aucun risque d'en oublier un et de laisser une
/// porte ouverte. La progression n'est pas perdue au passage : `LessonProgress`
/// est indexé par `[userId, lessonId]` et survit à la suppression d'un
/// `Enrollment`, ce qui permet de recalculer l'avancement à la réactivation.
model Registration {
  id        String             @id @default(cuid())
  studentId String
  student   User               @relation("StudentRegistrations", fields: [studentId], references: [id], onDelete: Cascade)
  sessionId String
  session   TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  status    RegistrationStatus @default(PENDING)

  registeredAt DateTime  @default(now())
  activatedAt  DateTime?
  suspendedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un élève ne s'inscrit qu'une fois à une session donnée.
  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@index([status])
}

/// Statuts d'une inscription — les cinq états demandés au cahier des charges.
///
/// Seul `ACTIVE` ouvre les accès. `PENDING` couvre l'inscription enregistrée
/// mais non encore ouverte (accord de financement en attente, session à
/// venir) ; `SUSPENDED` la coupe temporairement ; `COMPLETED` et `CANCELLED`
/// la referment, la première au terme du parcours, la seconde avant.
enum RegistrationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
}
