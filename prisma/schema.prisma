// E-FormationGN — Schéma Prisma
// Marketplace francophone de formation en ligne (multi-formateurs).
// Tous les commentaires de domaine sont en français pour faciliter la
// collaboration produit ; les identifiants de modèles/champs restent en
// anglais (standard professionnel).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// En Prisma 7, l'URL de connexion se déclare dans prisma.config.ts
// (datasource.url), pas dans ce fichier. Voir https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

// ===========================================================================
// AUTHENTIFICATION & UTILISATEURS
// Compatible NextAuth v5 (Auth.js) avec le PrismaAdapter.
// Un même compte utilisateur peut avoir plusieurs rôles (élève + formateur).
// ===========================================================================

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
  // Sous-rôles administratifs (granularité CRM) — droits hérités d'ADMIN
  // limités au scope de chaque rôle (vérifications côté Server Action).
  MODERATOR
  SUPPORT
  FINANCE
  /// Gestionnaire de formation : suit les sociétés clientes, les élèves, les
  /// formations et les inscriptions. Volontairement tenu à l'écart des
  /// finances, de la sécurité et de la configuration de la plateforme — son
  /// métier est le suivi pédagogique et administratif, pas l'exploitation
  /// technique ni la comptabilité.
  MANAGER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

enum Currency {
  EUR
  USD
  GNF // Franc guinéen — Mobile Money local (CinetPay)
  XOF // Franc CFA Afrique de l'Ouest (Sénégal/Côte d'Ivoire/Mali — CinetPay)
}

enum Locale {
  FR
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  hashedPassword      String?
  // Timestamp du dernier changement de mot de passe. Lu par le JWT
  // callback : tout token émis AVANT cette date est considéré invalide
  // (force la déconnexion globale après reset password).
  passwordChangedAt   DateTime?
  /// Compte créé par le centre de formation avec un mot de passe provisoire :
  /// tant que ce drapeau est vrai, la navigation est redirigée vers l'écran de
  /// changement de mot de passe. Le mot de passe initial transitant par email
  /// en clair, le laisser en place indéfiniment reviendrait à publier l'accès.
  mustChangePassword  Boolean   @default(false)
  name           String?
  firstName      String?
  lastName       String?
  image          String?
  bio            String?   @db.Text
  headline       String?
  /// Téléphone de la personne. Champ libre et non contraint : les élèves d'une
  /// société peuvent être joignables sur un numéro français, étranger ou un
  /// poste interne, et un format imposé bloquerait la saisie plus qu'il ne
  /// fiabiliserait la donnée.
  phone          String?
  websiteUrl     String?
  linkedinUrl    String?
  twitterUrl     String?
  youtubeUrl     String?

  role         UserRole      @default(STUDENT)
  isInstructor Boolean       @default(false)
  status       AccountStatus @default(PENDING_VERIFICATION)

  preferredCurrency Currency @default(EUR)
  preferredLocale   Locale   @default(FR)

  // Métadonnées CRM
  country        String?
  lastLoginAt    DateTime?
  bannedAt       DateTime?
  bannedReason   String?   @db.Text
  internalNotes  String?   @db.Text

  // Stripe Connect (formateurs)
  stripeAccountId      String? @unique
  stripeAccountStatus  String?
  stripeOnboardingDone Boolean @default(false)

  // Stripe Customer (élèves)
  stripeCustomerId String? @unique

  // Affiliation
  affiliateCode String? @unique
  referredById  String?
  referredBy    User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals     User[]  @relation("UserReferrals")

  // Relations NextAuth & vérification email
  accounts           Account[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  passwordResets     PasswordResetToken[]

  // Relations métier
  coursesAuthored Course[]         @relation("CoursesByInstructor")
  enrollments     Enrollment[]
  reviews         Review[]
  questions       Question[]
  answers         Answer[]
  notes           LessonNote[]
  lessonBookmarks LessonBookmark[]
  courseAnnouncementsAuthored CourseAnnouncement[] @relation("CourseAnnouncementAuthor")
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orders          Order[]
  certificates    Certificate[]
  quizAttempts    QuizAttempt[]
  lessonProgress  LessonProgress[]
  learningSessions LearningSession[]
  affiliateClicks AffiliateClick[]
  payouts         Payout[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  promoCodes      PromoCode[]      @relation("InstructorPromoCodes")
  // CRM
  supportTicketsRequested SupportTicket[] @relation("TicketRequester")
  supportTicketsAssigned  SupportTicket[] @relation("TicketAssignee")
  ticketMessages          TicketMessage[]
  reportsFiled            Report[]        @relation("Reporter")
  bannedIPs               BannedIP[]      @relation("BannedByAdmin")
  gdprRequests            GdprRequest[]
  adminNotesAuthored      AdminNote[]
  emailCampaignRecipients EmailCampaignRecipient[]
  userSegments            UserSegment[]   @relation("SegmentAuthor")
  impersonationsAsAdmin   ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsAsTarget  ImpersonationSession[] @relation("ImpersonationTarget")
  loginAttempts           LoginAttempt[]
  registrations           Registration[]  @relation("StudentRegistrations")

  // Rattachement à une société cliente (mode centre de formation).
  // `onDelete: Restrict` : on ne doit jamais perdre des élèves parce qu'une
  // société a été supprimée par erreur. L'archivage se fait via
  // `Company.status`, pas par suppression.
  companyId String?
  company   Company? @relation("CompanyStudents", fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Jeton de vérification d'adresse email (notre flux custom — pas le
// VerificationToken de l'adapter NextAuth, qu'on n'utilise pas car nous
// n'avons pas de magic-link login).
model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String?
  identifier String
  token      String   @unique
  expires    DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String    @id @default(cuid())
  userId  String
  token   String    @unique
  expires DateTime
  usedAt  DateTime?
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===========================================================================
// CATALOGUE — CATÉGORIES, COURS, SECTIONS, LEÇONS
// ===========================================================================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  RESOURCE
}

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  description  String?    @db.Text
  iconName     String?
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryParent")
  courses      Course[]
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([slug])
}

model Course {
  id                   String  @id @default(cuid())
  slug                 String  @unique
  title                String
  subtitle             String?
  description          String  @db.Text
  thumbnailUrl         String?
  promoVideoMuxId      String?
  promoVideoPlaybackId String?
  promoVideoUrl        String?

  level           CourseLevel @default(ALL_LEVELS)
  language        Locale      @default(FR)
  durationSeconds Int         @default(0)

  // Tarification
  // EUR / USD (cartes Stripe, diaspora) — Decimal 2 décimales
  priceEUR         Decimal   @default(0) @db.Decimal(10, 2)
  priceUSD         Decimal   @default(0) @db.Decimal(10, 2)
  discountPriceEUR Decimal?  @db.Decimal(10, 2)
  discountPriceUSD Decimal?  @db.Decimal(10, 2)
  // GNF / XOF (Mobile Money + cartes locales CinetPay) — Decimal 0 décimale
  // (ces devises n'ont pas de subdivision)
  priceGNF         Decimal   @default(0) @db.Decimal(12, 0)
  priceXOF         Decimal   @default(0) @db.Decimal(12, 0)
  discountPriceGNF Decimal?  @db.Decimal(12, 0)
  discountPriceXOF Decimal?  @db.Decimal(12, 0)
  discountEndsAt   DateTime?

  // Modération
  status          CourseStatus @default(DRAFT)
  publishedAt     DateTime?
  rejectionReason String?      @db.Text

  // SEO
  metaTitle        String?
  metaDescription  String?  @db.Text
  whatYouWillLearn String[]
  requirements     String[]
  targetAudience   String[]

  // Statistiques agrégées
  averageRating    Float @default(0)
  totalRatings     Int   @default(0)
  totalEnrollments Int   @default(0)

  // Curation admin
  isFeatured     Boolean  @default(false)
  featuredOrder  Int?
  internalNotes  String?  @db.Text

  // Relations
  instructorId    String
  instructor      User              @relation("CoursesByInstructor", fields: [instructorId], references: [id])
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  sections        Section[]
  enrollments     Enrollment[]
  reviews         Review[]
  questions       Question[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  certificates    Certificate[]
  promoCodes      CoursePromoCode[]
  affiliateClicks AffiliateClick[]
  announcements   CourseAnnouncement[]
  tags            Tag[]             @relation("CourseTags")
  /// Formations qui intègrent ce cours. `Restrict` côté ProgramCourse : on ne
  /// supprime pas un cours encore utilisé par un programme.
  programs        ProgramCourse[]

  /// Index de recherche plein texte, alimenté par un trigger SQL — voir la
  /// migration `1_course_search`. Prisma ne connaît pas le type `tsvector`,
  /// d'où `Unsupported` : la colonne n'est pas lisible via le client (la
  /// recherche passe par du SQL brut dans src/server/queries/courses.ts), mais
  /// elle est DÉCLARÉE.
  ///
  /// Cette déclaration n'est pas cosmétique : sans elle, Prisma considère la
  /// colonne comme orpheline et tout `migrate dev` génère un `DROP COLUMN`
  /// silencieux qui casserait la recherche de cours.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  // Les deux index suivants existent en base depuis des migrations SQL brutes
  // (`3_admin_crm` et `1_course_search`). Ils sont déclarés ici pour la même
  // raison que `searchVector` : non déclarés, Prisma les prend pour des
  // orphelins et chaque `migrate dev` génère un `DROP INDEX` qui dégraderait
  // silencieusement la mise en avant des cours et la recherche plein texte.
  @@index([isFeatured, featuredOrder])
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin)
}

model Tag {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  courses Course[] @relation("CourseTags")
}

model Section {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(0)
  lessons      Lesson[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId])
}

model Lesson {
  id            String     @id @default(cuid())
  sectionId     String
  section       Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title         String
  description   String?    @db.Text
  type          LessonType @default(VIDEO)
  displayOrder  Int        @default(0)
  isFreePreview Boolean    @default(false)

  // Vidéo
  muxAssetId           String?
  muxPlaybackId        String?
  muxUploadId          String?
  videoDurationSeconds Int     @default(0)

  // URL .mp4 externe : sert de fallback au player quand la leçon n'utilise
  // pas Mux (ex : démo seed avec Blender CC, ou contenu hébergé ailleurs).
  // Le player priorise muxPlaybackId si présent.
  externalVideoUrl String?

  // Texte
  textContent String? @db.Text

  // Ressource
  resourceUrl      String?
  resourceFileName String?

  transcript String? @db.Text

  // Résumé pédagogique généré par IA. Régénéré à la demande du formateur ;
  // affiché aux élèves au-dessus de la leçon pour préparer le visionnage.
  aiSummary          String?   @db.Text
  aiSummaryUpdatedAt DateTime?

  resources LessonResource[]
  quiz      Quiz?
  progress  LessonProgress[]
  notes     LessonNote[]
  bookmarks LessonBookmark[]
  questions Question[]
  learningSessions LearningSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

model LessonResource {
  id            String   @id @default(cuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String
  url           String
  fileSizeBytes Int?
  createdAt     DateTime @default(now())

  @@index([lessonId])
}

// ===========================================================================
// QUIZ
// ===========================================================================

enum QuestionKind {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model Quiz {
  id           String         @id @default(cuid())
  lessonId     String         @unique
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  description  String?        @db.Text
  passingScore Int            @default(70)
  maxAttempts  Int?
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt       String       @db.Text
  explanation  String?      @db.Text
  kind         QuestionKind @default(SINGLE_CHOICE)
  displayOrder Int          @default(0)
  points       Int          @default(1)
  options      QuizOption[]
  answers      QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id           String       @id @default(cuid())
  questionId   String
  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String       @db.Text
  isCorrect    Boolean      @default(false)
  displayOrder Int          @default(0)
  answers      QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int          @default(0)
  passed      Boolean      @default(false)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  attemptNumber Int
  snapshot      Json
  answers     QuizAnswer[]

  @@unique([quizId, userId, attemptNumber])
  @@index([userId])
  @@index([quizId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionId   String?
  option     QuizOption?  @relation(fields: [optionId], references: [id], onDelete: SetNull)
  textAnswer String?
  isCorrect  Boolean      @default(false)

  @@index([attemptId])
  @@index([questionId])
}

// ===========================================================================
// INSCRIPTIONS, PROGRESSION, AVIS, NOTES, Q&A
// ===========================================================================

enum EnrollmentSource {
  PURCHASE
  AFFILIATE
  PROMO_FREE
  ADMIN_GRANT
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  progressPercent Float            @default(0)
  lastAccessedAt  DateTime?
  orderItemId     String?          @unique
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id])
  source          EnrollmentSource @default(PURCHASE)
  learningSessions LearningSession[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

/// Session de présence active. Le client ne fournit jamais une durée : le
/// serveur additionne uniquement l'intervalle entre deux heartbeats rapprochés.
model LearningSession {
  id              String     @id @default(cuid())
  sessionKey      String     @unique
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activeSeconds   Int        @default(0)
  startedAt       DateTime   @default(now())
  lastHeartbeatAt DateTime   @default(now())
  endedAt         DateTime?

  @@index([enrollmentId])
  @@index([userId, lessonId])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted         Boolean   @default(false)
  watchedSeconds      Int       @default(0)
  lastPositionSeconds Int       @default(0)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  // recomputeEnrollmentProgress compte les leçons complétées d'un user.
  @@index([userId, isCompleted])
}

model LessonNote {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId              String
  lesson                Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content               String   @db.Text
  videoTimestampSeconds Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, lessonId])
}

// Marque-page de leçon — bouton ♥ dans le header de lecture pour retrouver
// les leçons importantes plus tard via /apprentissage (vue d'ensemble).
model LessonBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

// Inscriptions newsletter — RGPD : consentement explicite horodaté + IP
// hashée. `unsubscribedAt` désactive sans supprimer la trace (droit à
// l'oubli = passage par admin pour suppression dure).
model NewsletterSubscription {
  id               String    @id @default(cuid())
  email            String    @unique
  source           String? // ex: "home-hero", "footer", "checkout-thank-you"
  consentedAt      DateTime  @default(now())
  unsubscribedAt   DateTime?
  // Token aléatoire généré à l'inscription, inclus dans chaque email pour
  // permettre /newsletter/desinscription?token=… sans révéler l'email.
  unsubscribeToken String    @unique
  ipHash           String?
  userAgent        String?

  @@index([unsubscribedAt])
}

// Annonces publiées par le formateur sur un cours. Visibles par tous les
// inscrits dans l'onglet « Annonces » de chaque leçon. Pas de fil par leçon
// (granularité = cours entier), ordonnées par date desc.
model CourseAnnouncement {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CourseAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, createdAt])
}

model Review {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating              Int
  title               String?
  comment             String?   @db.Text
  isPublished         Boolean   @default(true)
  // Réponse publique du formateur (style Udemy "Instructor reply"). Affichée
  // sous l'avis original, signée du formateur, visible publiquement.
  instructorReply     String?   @db.Text
  instructorRepliedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model Question {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String?
  // Une question reste consultable au niveau du cours si la leçon est supprimée.
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String   @db.Text
  visibility QuestionVisibility @default(PUBLIC)
  isResolved Boolean  @default(false)
  answers    Answer[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([courseId, visibility, createdAt])
  @@index([lessonId, createdAt])
  @@index([userId])
}

enum QuestionVisibility {
  PUBLIC
  PRIVATE
}

model Answer {
  id               String   @id @default(cuid())
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body             String   @db.Text
  isAcceptedAnswer Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([questionId])
}

// ===========================================================================
// PANIER, WISHLIST, COMMANDES, PAIEMENTS
// ===========================================================================

model CartItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model WishlistItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum CommissionSource {
  INSTRUCTOR_DRIVEN // Ventes via lien d'affiliation/audience du formateur → 15%
  PLATFORM_DRIVEN // Ventes générées par la plateforme → 30%
}

model Order {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id])
  status   OrderStatus @default(PENDING)
  currency Currency    @default(EUR)

  // Montants en cents (convention Stripe)
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)

  // Stripe
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeReceiptUrl        String?

  promoCodeId   String?
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])
  affiliateCode String?

  // Idempotency client : UUID v4 généré par le navigateur à chaque submit
  // du panier. Si le user double-clique, les deux requêtes ont la même clé
  // et la seconde retourne l'Order existant au lieu d'en créer une nouvelle.
  // UNIQUE par user (pas global, pour ne pas leak l'ID entre comptes).
  idempotencyKey String?

  items   OrderItem[]
  refunds Refund[]

  createdAt DateTime  @default(now())
  paidAt    DateTime?
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  // Analytics & finances filtrent status=PAID + paidAt sur une plage.
  @@index([status, paidAt])
  @@unique([userId, idempotencyKey])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Snapshot de prix (immuable)
  currency       Currency
  unitPriceCents Int
  discountCents  Int      @default(0)
  totalCents     Int

  // Commission
  commissionSource      CommissionSource
  commissionRateBps     Int // 1500 = 15%, 3000 = 30%
  platformFeeCents      Int
  instructorPayoutCents Int

  stripeTransferId String?

  enrollment  Enrollment?
  certificate Certificate?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([courseId])
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountCents    Int
  reason         String?  @db.Text
  stripeRefundId String?  @unique
  createdAt      DateTime @default(now())

  @@index([orderId])
  // Reporting financier : somme des remboursements par plage de dates.
  @@index([createdAt])
}

