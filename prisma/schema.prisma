// ===========================================================================
// AUDIT LOG (modération, changements de commission, suspensions...)
// ===========================================================================

// Append-only par convention applicative (createAuditLog dans
// src/server/services/audit-log.ts) — JAMAIS d'update/delete sur cette
// table en code métier. Le hash-chain (previousHash + hash) permet de
// détecter toute altération a posteriori (un changement de ligne casse
// la chaîne, vérifiable via /api/cron/cleanup ou audit manuel SQL).
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String // ex: "course.publish", "commission.update", "user.suspend"
  targetType   String? // ex: "Course", "User", "Order"
  targetId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  // Hash chain : chaque entrée hashe la précédente + son propre contenu.
  // Altérer une ligne casse la chaîne pour toutes les suivantes — détectable.
  previousHash String?  @db.Char(64)
  hash         String?  @db.Char(64)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

